{
  "manifest_version": 3,
  "name": "YTMind — Your video, understood",
  "version": "3.0.0",
  "minimum_chrome_version": "116",
  "description": "Turn YouTube evidence into study notes, actions, and a connected learning library.",
  "permissions": ["storage", "sidePanel", "alarms"],
  "host_permissions": ["https://www.youtube.com/*", "https://api.groq.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": { "default_path": "panel.html" },
  "options_page": "panel.html#settings",
  "action": {
    "default_title": "Open YTMind",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self' blob:; connect-src 'self' https://api.groq.com"
  }
}
