{
  "manifest_version": 3,
  "name": "YTMind - Your video, understood",
  "version": "3.0.34",
  "minimum_chrome_version": "116",
  "description": "Save webpages, understand YouTube videos, and build notes, quizzes and a searchable learning library.",
  "permissions": [
    "storage",
    "sidePanel",
    "alarms",
    "activeTab",
    "scripting",
    "tabCapture",
    "offscreen"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      }
    }
  },
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": ["https://www.youtube.com/*"],
      "js": ["web-content.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "panel.html"
  },
  "options_page": "panel.html#settings",
  "action": {
    "default_title": "Open YTMind",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'; connect-src 'self' https://api.groq.com http://127.0.0.1:4175"
  },
  "web_accessible_resources": [
    {
      "resources": ["panel.html"],
      "matches": ["https://www.youtube.com/*"]
    }
  ]
}
