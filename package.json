{
  "name": "ytmind",
  "version": "3.0.21",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js",
    "check": "npm test && npm run build",
    "preview": "node scripts/preview.mjs",
    "test:ui": "node tests/ui.mjs",
    "test:extension": "node tests/extension.mjs",
    "format": "prettier --write src scripts tests public research/*.mjs research/*.json research/*.md *.json *.md docs/*.md",
    "test:ocr": "node tests/ocr.mjs",
    "research:retrieval": "node research/run-retrieval.mjs",
    "research:report": "node research/report.mjs",
    "research:live": "node research/run-live.mjs",
    "research:live-report": "node research/live-report.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "start": "node scripts/preview.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "test:audio:live": "node tests/live-audio.mjs",
    "setup:media": "node scripts/setup-media.mjs",
    "test:art-track:live": "node tests/live-art-track.mjs",
    "test:ocr:urdu": "node tests/ocr-urdu.mjs",
    "test:batch:live": "node tests/live-batch.mjs",
    "test:code:live": "node tests/live-code.mjs",
    "test:link:live": "node tests/live-link.mjs"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/urd": "^1.0.0",
    "dompurify": "^3.2.6",
    "marked": "^16.0.0",
    "tesseract.js": "^6.0.1",
    "wasm-feature-detect": "1.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "esbuild": "^0.25.0",
    "fake-indexeddb": "^6.0.0",
    "fflate": "^0.8.3",
    "prettier": "^3.9.10"
  }
}
