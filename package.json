{
  "name": "ytmind",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js",
    "check": "npm test && npm run build",
    "preview": "node scripts/preview.mjs",
    "test:ui": "node tests/ui.mjs",
    "test:extension": "node tests/extension.mjs",
    "format": "prettier --write src scripts tests public research/*.mjs research/*.json research/*.md *.json *.md docs/*.md",
    "test:ocr": "node tests/ocr.mjs",
    "research:retrieval": "node research/run-retrieval.mjs",
    "research:report": "node research/report.mjs",
    "research:live": "node research/run-live.mjs",
    "research:live-report": "node research/live-report.mjs",
    "check:secrets": "node scripts/check-secrets.mjs"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "dompurify": "^3.2.6",
    "marked": "^16.0.0",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "esbuild": "^0.25.0",
    "fake-indexeddb": "^6.0.0",
    "prettier": "^3.9.10"
  }
}
